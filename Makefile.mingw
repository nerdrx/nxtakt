# NxTakt — Windows cross build (mingw-w64): the headless subset, and the GUI.
#
#   make -f Makefile.mingw config           show toolchain + what was detected
#   make -f Makefile.mingw                  build the headless subset (default)
#   make -f Makefile.mingw check            build, then run the suite under wine
#   make -f Makefile.mingw verify-sources   prove the file lists match Makefile
#   make -f Makefile.mingw gui              build build-mingw/nxtakt.exe
#   make -f Makefile.mingw clean
#
# What this builds
# ----------------
#   build-mingw/engine_test.exe        the engine suite -- the whole of it, linked
#                                      fully static so `wine engine_test.exe`
#                                      needs no DLLs next to it.
#   build-mingw/obj/src/ui/window_win32.o        compile-only, never linked.
#   build-mingw/obj/src/audio/backend_win32.o
#                                      The point is to put a Windows-targeting
#                                      compiler in
#                                      front of the two hand-written Win32
#                                      translation units on every push, so they
#                                      cannot rot silently the way they did
#                                      while they were unbuildable.
#
#   build-mingw/nxtakt.exe             the GUI -- NOT part of `all`, built by
#                                      `make -f Makefile.mingw gui`. Needs a
#                                      sysroot; `tools/win-sysroot.sh` fetches
#                                      one. See "The GUI" at the bottom.
#
# What this deliberately does NOT build
# -------------------------------------
#   src/ipc/*. tests/ipc_test.cpp is built on POSIX shared memory (shm_open,
#   mmap, ftruncate, process-shared pthread mutexes). There is no thin shim for
#   that on Win32 -- it is CreateFileMappingW/MapViewOfFile plus named mutexes,
#   i.e. a second implementation of src/ipc/shm.h, not a build fix. Out of
#   scope here, and excluded on purpose rather than by accident.
#
#   tools/render.exe. Wants libsndfile + libsamplerate for Windows; see the
#   optional target at the bottom.
#
# The Linux Makefile is untouched and stays the source of truth for the native
# build. `make -f Makefile.mingw verify-sources` mechanically checks that the
# two agree about which files make up engine_test and about the warning flags,
# so the lists cannot drift apart unnoticed.

CROSS    ?= x86_64-w64-mingw32
# Host compiler, used only by verify-shim -- see that target.
NATIVE_CXX ?= g++
CXX      := $(CROSS)-g++
BUILD    := build-mingw
OBJDIR   := $(BUILD)/obj

# ---- sources --------------------------------------------------------------
# Must stay identical to the `build/engine_test:` rule in Makefile.
TEST_SRC := tests/engine_test.cpp src/audio/engine.cpp src/core/common.cpp

# Compiled, never linked.
WIN_ONLY_SRC := src/ui/window_win32.cpp src/audio/backend_win32.cpp
WIN_ONLY_OBJ := $(patsubst %.cpp,$(OBJDIR)/%.o,$(WIN_ONLY_SRC))

# ---- flags ----------------------------------------------------------------
# Kept character-for-character in step with Makefile's WARN; verify-sources
# fails the build if the two ever diverge.
WARN     := -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers

# _WIN32_WINNT 0x0A00: WASAPI needs >= Vista and the per-monitor-v2 DPI entry
# points need the Windows 10 headers. Both are still looked up at run time.
#
# __USE_MINGW_ANSI_STDIO=1 is not cosmetic. Without it printf resolves to
# msvcrt's implementation, which does not understand %zu and is inconsistent
# about %lld -- and tests/engine_test.cpp prints frame counts with %lld and
# buffer offsets with %zu in the text of ~30 assertions. Getting that wrong
# would not fail the suite, it would quietly print garbage next to PASS.
# -std=c++20 (rather than gnu++20) defines __STRICT_ANSI__, which already flips
# this on in current mingw-w64 headers; saying it explicitly makes the build
# independent of that detail.
WINDEFS  := -DUNICODE -D_UNICODE -DWINVER=0x0A00 -D_WIN32_WINNT=0x0A00 \
            -D__USE_MINGW_ANSI_STDIO=1

# -Itools/mingw-shim supplies <sndfile.h> and <samplerate.h> as compile-only
# stubs whose every entry point aborts. tests/engine_test.cpp includes
# src/audio/sample.cpp to reach detectTransients() -- pure in-memory DSP -- and
# that TU happens to share a file with loadSample(), which reads with libsndfile
# and resamples with libsamplerate. Neither is packaged cross-built for mingw on
# any runner image, so the whole cross build stopped compiling the moment that
# include landed, for a dependency the Windows suite never calls.
#
# The stubs cannot fake a pass: reaching one prints which function it was and
# calls abort(). `verify-shim` compiles the same assertions against both the
# stubs and the real headers, so they cannot drift from upstream unnoticed.
# Delete the flag and this directory the day apt ships the real cross builds --
# the workflow prints, every run, whether that has happened.
SHIM_INC := -Itools/mingw-shim

# Libraries the cross build satisfies with a shim rather than a real package.
# verify-sources fails if tests/engine_test.cpp's include closure grows a
# third-party dependency that is not on this list.
SHIMMED  := samplerate.h sndfile.h

CXXFLAGS := -std=c++20 -fno-math-errno $(WARN) $(WINDEFS) -Ivendor/clap/include \
            $(SHIM_INC) -MMD -MP

ifeq ($(MAKECMDGOALS),debug)
  CXXFLAGS += -O0 -g3 -fno-omit-frame-pointer -DLAT_DEBUG=1
else
  CXXFLAGS += -O2 -g -DNDEBUG
endif

# -mconsole: engine_test writes its results to stdout; the GUI subsystem would
# throw them away. Fully static so the .exe runs in a bare wineprefix with no
# libstdc++-6.dll / libgcc_s_seh-1.dll / libwinpthread-1.dll beside it.
#
# --stack is load bearing, not defensive. sizeof(lat::Engine) is ~2.35 MB (the
# realtime path never allocates, so every per-track buffer is a fixed-size
# member) and tests/engine_test.cpp declares `Host h;` -- which embeds one by
# value -- as a local in roughly thirty test functions. Linux gives a thread
# 8 MB of stack and nobody ever noticed; a PE gets 2 MB of stack reserve by
# default under mingw-w64, and Windows itself defaults to 1 MB, so the very
# first test overflows and the process dies with a plain access violation
# somewhere inside Engine::prepare. Reproduce the same crash natively with
# `ulimit -s 2048; ./build/engine_test`. 16 MB is generous for one Engine plus
# the check framework, and costs nothing: it is reserve, not commit.
LDFLAGS  := -mconsole -static-libgcc -static-libstdc++ -static \
            -Wl,--stack,16777216

TEST_OBJ := $(patsubst %.cpp,$(OBJDIR)/%.o,$(TEST_SRC))
DEP      := $(TEST_OBJ:.o=.d) $(WIN_ONLY_OBJ:.o=.d)

EXE      := $(BUILD)/engine_test.exe

.PHONY: all debug check clean config verify-sources verify-deps verify-shim winobjs \
        gui gui-dlls gui-config

all: $(EXE) winobjs
debug: all

winobjs: $(WIN_ONLY_OBJ)

# Everything a failing CI log needs, in one place, before anything is compiled.
config:
	@echo "cross prefix   : $(CROSS)"
	@echo "compiler       : $(CXX)"
	@command -v $(CXX) >/dev/null || \
	  { echo "*** $(CXX) not found -- install mingw-w64"; exit 1; }
	@$(CXX) --version | head -1 | sed 's/^/compiler ver   : /'
	@echo "target         : $$($(CXX) -dumpmachine)"
	@$(CXX) -v 2>&1 | grep -i 'thread model' | sed 's/^/thread model   : /'
	@echo "test sources   : $(TEST_SRC)"
	@echo "compile-only   : $(WIN_ONLY_SRC)"
	@echo "cxxflags       : $(CXXFLAGS)"
	@echo "ldflags        : $(LDFLAGS)"

$(EXE): $(TEST_OBJ)
	@mkdir -p $(dir $@)
	$(CXX) $(TEST_OBJ) -o $@ $(LDFLAGS)
	@echo "  ->  $@"

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Runs exactly the binary CI runs. WINEDEBUG=-all keeps wine's fixme spam out
# of the test output; the suite's own exit code decides pass/fail.
check: all
	WINEDEBUG=-all wine ./$(EXE)

# ---- consistency with the native Makefile ---------------------------------
# Two things can drift silently: which files engine_test is made of, and which
# warnings are on. Both are cheap to assert, so assert them instead of trusting
# a comment. CI runs this before the build.
verify-sources:
	@mkdir -p $(BUILD)
	@grep -E '^build/engine_test:' Makefile \
	  | sed 's/^[^:]*://' | tr ' ' '\n' | sed '/^$$/d' | sort > $(BUILD)/.src-native
	@printf '%s\n' $(TEST_SRC) | sort > $(BUILD)/.src-cross
	@diff -u $(BUILD)/.src-native $(BUILD)/.src-cross || { \
	  echo "*** engine_test sources differ between Makefile and Makefile.mingw"; \
	  exit 1; }
	@echo "engine_test sources match Makefile: $(TEST_SRC)"
	@grep -E '^WARN[[:space:]]*:=' Makefile       | sed 's/.*:=[[:space:]]*//' > $(BUILD)/.warn-native
	@grep -E '^WARN[[:space:]]*:=' Makefile.mingw | sed 's/.*:=[[:space:]]*//' > $(BUILD)/.warn-cross
	@diff -u $(BUILD)/.warn-native $(BUILD)/.warn-cross || { \
	  echo "*** WARN flags differ between Makefile and Makefile.mingw"; \
	  exit 1; }
	@echo "WARN matches Makefile: $(WARN)"
	@for f in $(TEST_SRC) $(WIN_ONLY_SRC) $(RENDER_SRC); do \
	  test -f "$$f" || { echo "*** missing source: $$f"; exit 1; }; \
	done
	@echo "every referenced source exists"
	@$(MAKE) -s -f Makefile.mingw verify-deps

# The check the two above could not make.
#
# Comparing prerequisite lists proves the native and cross builds compile the
# same FILES. It says nothing about what those files include -- and that is the
# gap the Windows job actually fell through. tests/engine_test.cpp grew
#
#     #include "../src/audio/sample.cpp"
#
# to reach detectTransients(). No rule changed, so verify-sources stayed happy
# through six commits of red, while the cross build had been unable to find
# <sndfile.h> the entire time.
#
# So: derive the dependencies from the sources instead of from the makefile.
# tools/scan_deps.sh walks the transitive #include closure and prints every
# third-party header in it; anything not on $(SHIMMED) is a library the cross
# build has no way to satisfy, and the failure is reported here, by name, in a
# step that runs before the compiler and needs no toolchain to run at all.
verify-deps:
	@mkdir -p $(BUILD)
	@tools/scan_deps.sh $(TEST_SRC) | sort -u > $(BUILD)/.deps-found
	@printf '%s\n' $(SHIMMED) | sort -u > $(BUILD)/.deps-allowed
	@if comm -23 $(BUILD)/.deps-found $(BUILD)/.deps-allowed | grep -q .; then \
	  echo "*** engine_test's include closure needs libraries the cross build cannot satisfy:"; \
	  comm -23 $(BUILD)/.deps-found $(BUILD)/.deps-allowed | sed 's/^/      /'; \
	  echo ""; \
	  echo "    Each of these arrived through an #include, not through a link line,"; \
	  echo "    which is why the source lists still match. Options, best first:"; \
	  echo "      1. do not pull that TU into engine_test -- move the function the"; \
	  echo "         tests need into a header or a TU without the dependency;"; \
	  echo "      2. add a compile-only stub under tools/mingw-shim and list it in"; \
	  echo "         SHIMMED, if the Windows suite provably never calls into it;"; \
	  echo "      3. vendor a real cross-built library and link it."; \
	  exit 1; \
	fi
	@echo "third-party deps in engine_test's closure: $$(cat $(BUILD)/.deps-found | tr '\n' ' ')(all shimmed)"

# Compiles tools/mingw-shim/verify_shim.cpp twice -- against the stubs and
# against the real headers -- so the stubs cannot drift from upstream. Uses the
# NATIVE compiler on purpose: it is a statement about the headers, not about
# code generation, and it must run on a developer box with no mingw installed.
# Skipped with a clear message, never silently, if the real headers are absent.
verify-shim:
	@mkdir -p $(BUILD)
	@$(NATIVE_CXX) -std=c++20 -Itools/mingw-shim -fsyntax-only \
	   tools/mingw-shim/verify_shim.cpp \
	  || { echo "*** the mingw shim headers do not satisfy their own assertions"; exit 1; }
	@echo "shim headers: assertions hold"
	@if pkg-config --exists sndfile samplerate; then \
	  $(NATIVE_CXX) -std=c++20 $$(pkg-config --cflags sndfile samplerate) \
	     -fsyntax-only tools/mingw-shim/verify_shim.cpp \
	    || { echo "*** the shim has drifted from the real libsndfile/libsamplerate headers"; \
	         echo "    the static_assert above names the member or signature that moved"; \
	         exit 1; }; \
	  echo "real headers: same assertions hold -- shim matches upstream"; \
	else \
	  echo "real headers: libsndfile/libsamplerate not installed, upstream half skipped"; \
	fi

clean:
	rm -rf $(BUILD)

# ---- optional: the deviceless render tool ---------------------------------
# Stretch goal, off by default and not part of `all`. tools/render.cpp pulls in
# src/audio/sample.cpp, which needs libsndfile and libsamplerate built for
# Windows. Debian/Ubuntu cross-build neither, so this needs a hand-populated
# sysroot:
#
#   make -f Makefile.mingw WIN_DEPS=/path/to/sysroot build-mingw/render.exe
#
# with $(WIN_DEPS)/{include,lib} holding sndfile.h / samplerate.h and their
# import or static libraries. Unlike engine_test.exe this one is not -static: a
# static libsndfile drags in FLAC/ogg/vorbis/opus/mpg123 and the link order
# stops being something a makefile can guess.
# Defaults to what tools/win-sysroot.sh populates, so neither this target nor
# the GUI needs an argument on a machine where that script has been run.
WIN_DEPS ?= $(BUILD)/sysroot
RENDER_SRC := tools/render.cpp src/core/common.cpp src/core/project.cpp \
              src/audio/sample.cpp src/audio/engine.cpp

$(BUILD)/render.exe: $(RENDER_SRC)
	@test -d "$(WIN_DEPS)/include" || { \
	  echo "render.exe needs a sysroot with sndfile+samplerate:"; \
	  echo "    tools/win-sysroot.sh          (populates $(WIN_DEPS))"; \
	  echo "    ... or pass WIN_DEPS=/path/to/win32/sysroot"; \
	  exit 1; }
	@mkdir -p $(dir $@)
	@# SHIM_INC is filtered out deliberately, and this is not a nicety. Include
	@# directories are searched left to right, and SHIM_INC sits early in
	@# CXXFLAGS, so leaving it in would shadow the real sndfile.h/samplerate.h
	@# in $(WIN_DEPS)/include with the abort-on-call stubs. render.exe genuinely
	@# reads and resamples files: it would build, link against a real libsndfile
	@# it never calls, and die on the first loadSample() with a shim message --
	@# for a target whose whole point is that the real libraries are present.
	$(CXX) $(filter-out $(SHIM_INC),$(CXXFLAGS)) -I$(WIN_DEPS)/include \
	  $(RENDER_SRC) -o $@ \
	  -mconsole -static-libgcc -static-libstdc++ \
	  -L$(WIN_DEPS)/lib -lsndfile -lsamplerate

# ===========================================================================
# The GUI
# ===========================================================================
#
#   tools/win-sysroot.sh                    fetch freetype/sndfile/samplerate
#   make -f Makefile.mingw gui              -> build-mingw/nxtakt.exe (+ DLLs)
#   tools/headless_win_test.sh              run it under wine, in gamescope
#
# NOT part of `all`, and not run by the windows-cross CI job: `all` must stay
# buildable with nothing but apt's mingw-w64, which is what makes the headless
# engine suite a check every push can afford. This target needs the sysroot.
#
# What is in the link, and what is not
# ------------------------------------
# The file list is derived the same way the native Makefile derives its own --
# `find src -name '*.cpp'` -- so a new source file joins both builds at once.
# Six files are then subtracted, and each one is a platform decision rather
# than an oversight:
#
#   ui/window_x11.cpp      X11/GLX          window_win32.cpp replaces it
#   ui/window_wayland.cpp  Wayland/EGL      likewise
#   audio/backend.cpp      JACK + ALSA      backend_win32.cpp replaces it
#   audio/midi_in.cpp      ALSA sequencer   stubbed (no WinMM backend yet)
#   plugin/lv2_host.cpp    lilv + LV2       stubbed (CLAP covers Windows)
#   daemon/*               separate program, as on Linux
#
# The two stubs live in tools/mingw-shim/win/win_stubs.cpp. Everything else --
# every app_*.cpp, the renderer, the project format, the internal devices, the
# CLAP host, the OSC parser -- is compiled from the same source the Linux build
# uses, with no conditionals. tools/mingw-shim/win/ is what makes that possible
# and its README explains the cost.
#
# Include-path order is load bearing. WIN_SHIM_INC has to come before the
# toolchain's own directories (its unistd.h chains to mingw's with
# #include_next) and SHIM_INC must NOT be here at all: the GUI links the real
# libsndfile and would otherwise compile against the abort-on-call stubs, same
# trap as render.exe.
GUI_EXCLUDE  := src/ui/window_x11.cpp src/ui/window_wayland.cpp \
                src/audio/backend.cpp src/audio/midi_in.cpp \
                src/plugin/lv2_host.cpp
GUI_SRC      := $(filter-out $(GUI_EXCLUDE),$(filter-out src/daemon/%,$(shell find src -name '*.cpp' | sort))) \
                tools/mingw-shim/win/win_posix.cpp tools/mingw-shim/win/win_stubs.cpp

WIN_SHIM_INC := -Itools/mingw-shim/win
# Defined before GUI_CF, which is a := variable: a VERSION set after it would
# expand to nothing and the binary would report its version as an empty string.
VERSION      ?= $(shell git describe --tags --always 2>/dev/null || echo dev)
GUI_CF       := $(filter-out $(SHIM_INC),$(CXXFLAGS)) $(WIN_SHIM_INC) \
                -I$(WIN_DEPS)/include -I$(WIN_DEPS)/include/freetype2 \
                -DNXTAKT_VERSION='"$(VERSION)"'

# -mconsole, not -mwindows, and that is not a placeholder: every LOGI/LOGW/LOGE
# in this program goes to stdout, and under wine that is the only channel a
# first-light run has. A GUI-subsystem binary would throw all of it away and
# leave a black window and no explanation. Switch it when there is something to
# switch it for.
#
# --stack: docs/PORTING.md's warning applied to the app. The GUI keeps its
# Engine on the heap (EngineHandle owns a unique_ptr), so this is not the
# load-bearing flag it is for engine_test.exe -- but 2 MB is also the default
# for every thread the app spawns, and the audio callback path is deep.
#
# Not -static: libsndfile pulls FLAC/ogg/vorbis/opus/mpg123 and freetype pulls
# harfbuzz/glib; the import libraries plus `gui-dlls` are what keep that link
# line from becoming a research project. See tools/win-sysroot.sh.
GUI_LDFLAGS  := -mconsole -static-libgcc -static-libstdc++ -Wl,--stack,16777216
GUI_LIBS     := -L$(WIN_DEPS)/lib -lfreetype -lsndfile -lsamplerate \
                -lopengl32 -lgdi32 -lole32 -loleaut32 -lavrt -lksuser -lwinmm -luuid

GUI_OBJ      := $(patsubst %.cpp,$(OBJDIR)/gui/%.o,$(GUI_SRC))
GUI_EXE      := $(BUILD)/nxtakt.exe
DEP          += $(GUI_OBJ:.o=.d)

gui: $(GUI_EXE) gui-dlls

gui-config:
	@echo "sysroot        : $(WIN_DEPS)"
	@echo "sources        : $(words $(GUI_SRC)) translation units"
	@echo "excluded       : $(GUI_EXCLUDE)"
	@echo "cxxflags       : $(GUI_CF)"
	@echo "libs           : $(GUI_LIBS)"

$(GUI_EXE): $(GUI_OBJ)
	@mkdir -p $(dir $@)
	$(CXX) $(GUI_OBJ) -o $@ $(GUI_LDFLAGS) $(GUI_LIBS)
	@echo "  ->  $@"

# Separate object tree from the headless build's: the same .cpp is compiled
# with different include paths in the two (SHIM_INC vs the real headers), and
# sharing $(OBJDIR) would silently hand one build the other's objects.
$(OBJDIR)/gui/%.o: %.cpp | gui-sysroot-check
	@mkdir -p $(dir $@)
	$(CXX) $(GUI_CF) -c $< -o $@

.PHONY: gui-sysroot-check
gui-sysroot-check:
	@test -f "$(WIN_DEPS)/include/sndfile.h" || { \
	  echo "*** no Windows sysroot at $(WIN_DEPS)"; \
	  echo "    run:  tools/win-sysroot.sh"; \
	  echo "    (fetches pinned freetype/sndfile/samplerate + closure from MSYS2)"; \
	  exit 1; }

# The .exe imports 13 DLLs that are not part of Windows. They have to sit next
# to it -- Wine and Windows both search the executable's own directory first --
# so copying them is part of building, not part of packaging.
gui-dlls: $(GUI_EXE)
	@n=0; for dll in $$($(CROSS)-objdump -p $(GUI_EXE) | sed -n 's/.*DLL Name: //p'); do \
	  if [ -f "$(WIN_DEPS)/bin/$$dll" ] && [ ! -f "$(BUILD)/$$dll" ]; then \
	    cp "$(WIN_DEPS)/bin/$$dll" "$(BUILD)/"; n=$$((n+1)); \
	  fi; \
	done; \
	for pass in 1 2 3; do \
	  for f in $(BUILD)/*.dll; do \
	    for dll in $$($(CROSS)-objdump -p $$f | sed -n 's/.*DLL Name: //p'); do \
	      if [ -f "$(WIN_DEPS)/bin/$$dll" ] && [ ! -f "$(BUILD)/$$dll" ]; then \
	        cp "$(WIN_DEPS)/bin/$$dll" "$(BUILD)/"; n=$$((n+1)); \
	      fi; \
	    done; \
	  done; \
	done; \
	echo "  ->  $$n runtime DLLs beside $(GUI_EXE)"

-include $(DEP)
